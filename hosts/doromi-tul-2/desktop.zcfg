desktops.gnome = {
  enable = true;
  extensions = {
    forge.enable = true;
    user-themes.enable = true;
    app-hider.enable = true;
    hide-minimized.enable = true;
    hide-cursor.enable = true;
    burn-my-windows.enable = true;
    compiz-windows-effect.enable = true;
    compiz-alike-magic-lamp-effect.enable = true;
    rounded-window-corners-reborn.enable = true;
    blur-my-shell.enable = true;
    alphabetical-app-grid.enable = true;
    category-sorted-app-grid.enable = true;
    coverflow-alt-tab.enable = true;
    hide-top-bar.enable = true;
    mouse-tail.enable = true;
    window-is-ready-remover.enable = true;
    date-menu-formatter.enable = true;
    gsconnect.enable = true;
    clipboard-indicator.enable = true;
    notification-timeout.enable = true;
  };
  defaultDarkMode = true;
  defaultAccentColor = "purple";
  tweaks.zenos-fonts.enable = true;
  tweaks.zero-clock.enable = true;
  tweaks.firefox-theming.enable = true;
};
system.packages = {
  byCategories.theming.apps.adw-gtk3 = true;
  byCategories.theming.cursors.google-dot = true;
  byCategories.theming.icons.adwaita-hacks = true;
  byCategories.theming.fonts.zero.regular = true;
  byCategories.theming.fonts.zero.mono-thin = true;
};
users.doromiert.legacy.homeManager = {
  gtk = {
    enable = true;
    theme = { name = "adw-gtk3-dark"; package = $pkgs.byCategories.theming.apps.adw-gtk3; };
    iconTheme = { name = "Adwaita-hacks"; package = $pkgs.byCategories.theming.icons.adwaita-hacks; };
    cursorTheme = { name = "GoogleDot-Black"; size = 24; package = $pkgs.byCategories.theming.cursors.google-dot; };
    font = { name = "Atkinson Hyperlegible Next"; size = 11; package = $pkgs.legacy.atkinson-hyperlegible-next; };
  };
  home.pointerCursor = { name = "GoogleDot-Black"; size = 24; package = $pkgs.byCategories.theming.cursors.google-dot; gtk.enable = true; x11.enable = true; };
};
