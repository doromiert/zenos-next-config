# webapps
users.doromiert.legacy.homeManager = {
  programs.pwamaker = {
    enable = true;
    firefoxGnomeTheme = $pkgs.byCategories.theming.apps.firefox-gnome.src;

    # [NEW] Enable the internal Dispatcher
    dispatcher = {
      enable = true;
      fallbackBrowser = "firefox"; # Matches your global firefox binary name
    };

    apps = {
      instagram = {
        id = "instagram";
        name = "Instagram";
        url = "https://www.instagram.com";
        icon = "applications-photography";

        extensions = [
          { id = "uBlock0@raymondhill.net"; url = "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi"; }
          { id = "keepassxc-browser@keepassxc.org"; url = "https://addons.mozilla.org/firefox/downloads/latest/keepassxc-browser/latest.xpi"; }
        ];
        categories = [
          "Network"
          "Video"
          "AudioVideo"
        ];
        keywords = [
          "video"
          "music"
          "insta"
          "meta"
          "facebook"
          "stream"
        ];
        # Optional: Force YouTube links to open here too
        openUrls = [
          "instagram.com"
        ];
      };

      youtube = {
        id = "youtube";
        name = "YouTube";
        url = "https://www.youtube.com";
        icon = "youtube";

        # Custom Search Engine
        search = {
          name = "YouTube";
          url = "https://www.youtube.com/results?search_query={searchTerms}";
        };

        extensions = [
          { id = "uBlock0@raymondhill.net"; url = "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi"; }
          { id = "sponsorBlocker@ajay.app"; url = "https://addons.mozilla.org/firefox/downloads/latest/sponsorblock/latest.xpi"; }
          { id = "keepassxc-browser@keepassxc.org"; url = "https://addons.mozilla.org/firefox/downloads/latest/keepassxc-browser/latest.xpi"; }
          { id = "{a6c4a591-f1b2-4f03-b3ff-767e5bedf4e7}"; url = "https://addons.mozilla.org/firefox/downloads/latest/user-agent-string-switcher/latest.xpi"; }
        ];
        categories = [
          "Network"
          "Video"
          "AudioVideo"
        ];
        keywords = [
          "video"
          "music"
          "google"
          "stream"
        ];
        # Optional: Force YouTube links to open here too
        openUrls = [
          "youtube.com"
          "youtu.be"
        ];
      };

      github = {
        id = "github";
        name = "GitHub";
        url = "https://github.com";
        icon = "github";

        # Custom Search Engine
        search = {
          name = "GitHub";
          url = "https://github.com/search?q={searchTerms}";
        };
        layoutStart = [
          "home"
          "back"
          "forward"
          "reload"
        ];

        extensions = [
          { id = "uBlock0@raymondhill.net"; url = "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi"; }
          { id = "keepassxc-browser@keepassxc.org"; url = "https://addons.mozilla.org/firefox/downloads/latest/keepassxc-browser/latest.xpi"; }
        ];
        categories = [
          "Network"
          "Development"
        ];
        keywords = [
          "git"
          "github"
          "gh"
          "code"
        ];
        openUrls = [
          "github.com"
        ];
      };

      # figma = {
      #   id = "figma";
      #   name = "Select for Figma";
      #   url = "https://www.figma.com";
      #   icon = "select-for-figma";

      #   # Custom Search Engine (Community)
      #   search = {
      #     name = "Figma Community";
      #     url = "https://www.figma.com/community/search?query={searchTerms}&resource_type=mixed&editor_type=all&price=all&sort_by=relevancy&creators=all";
      #   };

      #   extensions = [
      #     { id = "{a6c4a591-f1b2-4f03-b3ff-767e5bedf4e7}"; url = "https://addons.mozilla.org/firefox/downloads/latest/user-agent-string-switcher/latest.xpi"; }
      #     { id = "keepassxc-browser@keepassxc.org"; url = "https://addons.mozilla.org/firefox/downloads/latest/keepassxc-browser/latest.xpi"; }
      #   ];
      #   categories = [
      #     "Graphics"
      #     "Development"
      #   ];
      #   keywords = [
      #     "design"
      #     "ui"
      #     "ux"
      #     "vector"
      #   ];
      #   # Split layout around the tabs (which are now implicit in the center)
      #   layoutStart = [
      #     "home"
      #     "reload"
      #   ];
      #   layoutEnd = [
      #     "addons"
      #   ];
      #   openUrls = [
      #     "figma.com"
      #   ];
      # };

      twitter = {
        id = "twitter";
        name = "Twitter";
        url = "https://x.com";
        icon = "twitter";

        # Custom Search Engine
        search = {
          name = "Twitter";
          url = "https://x.com/search?q={searchTerms}&src=typed_query";
        };

        extensions = [
          { id = "uBlock0@raymondhill.net"; url = "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi"; }
          { id = "keepassxc-browser@keepassxc.org"; url = "https://addons.mozilla.org/firefox/downloads/latest/keepassxc-browser/latest.xpi"; }
        ];
        categories = [
          "Network"
          "Chat"
        ];
        keywords = [
          "social"
          "media"
          "x"
        ];
        # [NEW] This captures x.com and twitter.com links!
        openUrls = [
          "x.com"
          "twitter.com"
        ];
        # Split layout around the tabs
        layoutStart = [
          "home"
          "back"
          "forward"
          "reload"
        ];
        layoutEnd = [
          "addons"
        ];
      };

      gemini = {
        id = "gemini";
        name = "Gemini";
        url = "https://gemini.google.com";
        icon = "internet-chat";
        # templateProfile = baseProfile;
        extensions = [
          { id = "keepassxc-browser@keepassxc.org"; url = "https://addons.mozilla.org/firefox/downloads/latest/keepassxc-browser/latest.xpi"; }
        ];
        categories = [
          "Network"
          "Office"
          "X-ArtificialIntelligence"
        ];
        keywords = [
          "ai"
          "chat"
          "llm"
          "google"
        ];
        openUrls = [
          "gemini.google.com"
          "aistudio.google.com"
        ];
      };

      claude = {
        id = "claude";
        name = "Claude";
        url = "https://claude.ai";
        icon = "internet-chat";
        # templateProfile = baseProfile;
        extensions = [
          { id = "claudesona@n8python"; url = "https://addons.mozilla.org/firefox/downloads/file/4795441/claudesona_emotion_sprites-1.0.1.xpi"; }
          { id = "keepassxc-browser@keepassxc.org"; url = "https://addons.mozilla.org/firefox/downloads/latest/keepassxc-browser/latest.xpi"; }
        ];
        categories = [
          "Network"
          "Office"
          "X-ArtificialIntelligence"
        ];
        keywords = [
          "ai"
          "chat"
          "llm"
          "anthropic"
        ];
        openUrls = [
          "claude.ai"
        ];
      };

      syncthing = {
        id = "syncthing";
        name = "Syncthing";
        url = "http://localhost:8384";
        icon = "syncthing";
        # templateProfile = baseProfile;
        categories = [
          "System"
          "FileTransfer"
        ];
        keywords = [
          "sync"
          "backup"
          "p2p"
        ];
        openUrls = [
          "localhost:8384"
          "127.0.0.1:8384"
        ];
      };
    };
  };
};


# shell
users.doromiert.legacy.homeManager = {
    xdg.userDirs = {
      enable = true;
      createDirectories = true;

      # Standard XDG paths
      download = "/Users/doromiert/Downloads";
      documents = "/Users/doromiert/Documents";
      desktop = "/Users/doromiert/Desktop";

      # Custom paths go into extraConfig
      extraConfig = {
        FUNNY = "/Users/doromiert/Funny";
        PROJECTS = "/Users/doromiert/Projects";
        THREED = "/Users/doromiert/3D";
        ANDROID = "/Users/doromiert/Android";
        AI = "/Users/doromiert/AI";
        APPS_SCRIPTS = "/Users/doromiert/Apps & Scripts";
        DOOM = "/Users/doromiert/Doom";
        RIFT = "/Users/doromiert/Rift";
        RANDOM = "/Users/doromiert/Random";
        PASSWORDS = "/Users/doromiert/Passwords";
      };
    };

    programs = {

      direnv = {
        enable = true;
        nix-direnv.enable = true;
      };

      zsh = {

        enable = true;
        enableCompletion = true;
        autosuggestion.enable = true;
        syntaxHighlighting.enable = true;

        # [P13.9] User-Specific Tools
        # Removed CD shortcuts as Zoxide handles navigation
        shellAliases = {
          # Git Rapid-Fire
          g = "git";
          ga = "git add";
          gaa = "git add .";
          gc = "git commit -m";
          gs = "git status";
          gp = "git push";
          gl = "git log --oneline --graph --decorate";

          # Nix / Direnv
          da = "direnv allow";
          dr = "direnv reload";

          # Networking
          myip = "curl ifconfig.me";
        };

        history.size = 10000;

plugins = [ { name = "powerlevel10k"; src = $pkgs.legacy.zsh-powerlevel10k; file = "share/zsh-powerlevel10k/powerlevel10k.zsh-theme"; } ];

        initContent = ''
          bindkey "''${key[Up]}" up-line-or-search
          bindkey "''${key[Down]}" down-line-or-search
        '';
      };

      zoxide = {

        enable = true;
        enableZshIntegration = true;
      };

      git = {
        enable = true;
        settings = {
          user = {
            name = "doromiert";
            email = "doromiert@gmail.com";
          };
          pull.rebase = false;
          init.defaultBranch = "main";
        };
      };
    };
};

users.doromiert = {
  profile = {
    normalUser = true; homeDirectory = "/Users/doromiert"; displayName = "doromiert"; uid = 1000;
    groups = [ "wheel" "networkmanager" "lp" "video" "input" "libvirtd" "kvm" "docker" ];
    loginShell = $pkgs.legacy.zsh;
  };
  services.vr = { enable = true; allowNetworkAccess = true; };
  programs = {
    select-for-figma.enable = true;
    zoxide = { enable = true; enableZshIntegration = true; };
    keepassxc = { enable = true; settings = {
      Browser = { Enabled = true; Firefox = true; SearchInAllDatabases = true; };
      GUI = { MinimizeOnStartup = true; MinimizeToTray = true; OpenPreviousDatabasesOnStartup = true; };
      PasswordGenerator.Length = 60;
    }; };
    firefox = { enable = true; nativeMessagingHosts = [ $pkgs.legacy.keepassxc ]; };
    vscode.enable = true;
  };
  shell.aliases = {
    g = "git"; ga = "git add"; gaa = "git add ."; gc = "git commit -m";
    gs = "git status"; gp = "git push"; gl = "git log --oneline --graph --decorate";
    da = "direnv allow"; dr = "direnv reload"; myip = "curl ifconfig.me";
  };
  legacy.homeManager = {
    home.stateVersion = "25.11";
  };
};
