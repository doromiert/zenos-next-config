            ClearURLs.enable = true;
            CopyUserURLs.enable = true;

            # Performance/Fixes
            # vencordToolbox.enable = true;
            webKeybinds.enable = true;

            # [NOTE] Often redundant on Vesktop (it has native fixes), but harmless to keep.
            webScreenShareFixes.enable = true;

