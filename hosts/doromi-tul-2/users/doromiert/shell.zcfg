users.doromiert.legacy.homeManager = {
    xdg.userDirs = {
      enable = true;
      createDirectories = true;

      # Standard XDG paths
      download = "/Users/doromiert/Downloads";
      documents = "/Users/doromiert/Documents";
      desktop = "/Users/doromiert/Desktop";

      # Custom paths go into extraConfig
      extraConfig = {
        FUNNY = "/Users/doromiert/Funny";
        PROJECTS = "/Users/doromiert/Projects";
        THREED = "/Users/doromiert/3D";
        ANDROID = "/Users/doromiert/Android";
        AI = "/Users/doromiert/AI";
        APPS_SCRIPTS = "/Users/doromiert/Apps & Scripts";
        DOOM = "/Users/doromiert/Doom";
        RIFT = "/Users/doromiert/Rift";
        RANDOM = "/Users/doromiert/Random";
        PASSWORDS = "/Users/doromiert/Passwords";
      };
    };

    programs = {

      direnv = {
        enable = true;
        nix-direnv.enable = true;
      };

      zsh = {

        enable = true;
        enableCompletion = true;
        autosuggestion.enable = true;
        syntaxHighlighting.enable = true;

        # [P13.9] User-Specific Tools
        # Removed CD shortcuts as Zoxide handles navigation
        shellAliases = {
          # Git Rapid-Fire
          g = "git";
          ga = "git add";
          gaa = "git add .";
          gc = "git commit -m";
          gs = "git status";
          gp = "git push";
          gl = "git log --oneline --graph --decorate";

          # Nix / Direnv
          da = "direnv allow";
          dr = "direnv reload";

          # Networking
          myip = "curl ifconfig.me";
        };

        history.size = 10000;

plugins = [ { name = "powerlevel10k"; src = $pkgs.legacy.zsh-powerlevel10k; file = "share/zsh-powerlevel10k/powerlevel10k.zsh-theme"; } ];

        initContent = ''
          bindkey "''${key[Up]}" up-line-or-search
          bindkey "''${key[Down]}" down-line-or-search
        '';
      };

      zoxide = {

        enable = true;
        enableZshIntegration = true;
      };

      git = {
        enable = true;
        settings = {
          user = {
            name = "doromiert";
            email = "doromiert@gmail.com";
          };
          pull.rebase = false;
          init.defaultBranch = "main";
        };
      };
    };
};
